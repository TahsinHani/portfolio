{% from "components/button.njk" import button %}
{#- Homepage "About": photo mood board, intro, basic facts and prior roles.
    The board's photos start stacked and are dealt out into this layout when it is scrolled to (mood-board.js).
    Facts and roles come from the homepage front matter → facts, experience. #}
<section class="section about" id="about" aria-labelledby="about-h">
  <div class="container about__grid">
    <div class="about__board">
      <div class="mood" data-mood>
        <figure class="mood__card mood__polaroid" data-i="0" tabindex="0">
          <i class="mood__tape mood__tape--a" aria-hidden="true"></i>
          {#- #}<img src="{{ '/assets/images/about-1.webp' | rel }}" width="800" height="800" alt="Illustrated portrait of a smiling child in a red cap, waving" loading="lazy" decoding="async" draggable="false" />
        </figure>
        <p class="mood__quote mood__quote--top">Curious from the&nbsp;beginning<br />about the world around&nbsp;me.</p>
        <p class="mood__quote mood__quote--bottom">Turning that curiosity into&nbsp;design.<br />Now designing. Still&nbsp;learning.</p>
        <figure class="mood__card mood__polaroid" data-i="1" tabindex="0">
          <i class="mood__tape mood__tape--b" aria-hidden="true"></i>
          {#- #}<img src="{{ '/assets/images/about-2.webp' | rel }}" width="800" height="800" alt="Illustrated portrait of Tahsin looking over a shoulder, sea behind" loading="lazy" decoding="async" draggable="false" />
        </figure>
      </div>
      <script defer src="{{ '/assets/js/mood-board.js' | rel }}"></script>
    </div>
    <div class="about__text about__intro">
      <div class="section-head"><h2 id="about-h">About</h2></div>
      <p class="about__lead">A designer shaped by curiosity and persistence</p>
      <p class="about__p">
        My path into product design began with graphic design. That experience taught me to care
        about visual communication and the details that guide attention. As I moved into UI/UX, my
        focus expanded to how people move through products, what they need from them, and how
        design can make complicated experiences easier to use.
      </p>
      <p class="about__p">
        At Astha IT, I’ve contributed to work across different industries and product types,
        including travel, field operations, education, and AI. Each project has helped me broaden
        my perspective and strengthen the way I approach a design challenge.
      </p>
      <p class="about__p">
        I’ve put sustained effort into growing beyond the screen: learning to frame problems, think
        through workflows, explain design decisions, and collaborate toward a product experience.
        I’m continuing to develop as a product designer who can connect visual quality with user
        needs and product context.
      </p>
      <div class="about__actions">
        {{ button("View resume", site.resume | rel, icon="resume", external=true) }}
        {{ button("Let's talk", site.booking, variant="secondary", trail="arrow-right", external=true) }}
      </div>
    </div>
  </div>
  {#- Both lists share one set of grid rows on wide screens so their dividers line up (CSS subgrid).
      --rows is the longer list's length. #}
  {%- set rows = facts | length -%}
  {%- if (experience | length) > rows %}{% set rows = experience | length %}{% endif %}
  <div class="container about__grid about__lower" style="--rows: {{ rows }}; --rows-head: {{ rows + 1 }}">
    <div class="about__prior-wrap">
      <h3 class="about__sub">Basic Information</h3>
      <dl class="about__facts">
        {%- for fact in facts %}
        <div>
          <dt>{{ fact.label }}</dt>
          {#- Items separated by " · " wrap as whole units, each keeping its trailing dot. #}
          <dd>
            {%- for part in fact.value.split(" · ") -%}
            <span class="about__item">{{ part }}{% if not loop.last %} ·{% endif %}</span>{% if not loop.last %} {% endif %}
            {%- endfor -%}
          </dd>
        </div>
        {%- endfor %}
      </dl>
    </div>
    <div class="about__prior-wrap">
      <h3 class="about__sub">Prior work</h3>
      <ul class="about__prior">
        {%- for job in experience %}
        <li>
          <span class="about__who"><span class="about__role">{{ job.role }}</span><span class="about__org">{{ job.org }}</span></span>
          {#- #}<span class="about__years">{{ job.years }}</span>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>
