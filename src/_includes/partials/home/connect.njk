{% from "components/icons.njk" import icon, socialLink %}
{#- Homepage closing block: "Working across time zones" map, contact panel and the footer, over one background.
    Map pins and their client logos come from the homepage front matter → mapPins.
    A pin with clients is a button; map-clients.js opens its logos on hover, keyboard focus or tap. #}
<div class="finale">
  <div class="finale__bg" aria-hidden="true" style="background-image: url({{ '/assets/images/footer-bg.webp' | rel }})"></div>
  <div class="finale__fade" aria-hidden="true"></div>
  <section class="section connect" id="connect" aria-labelledby="connect-h">
    <div class="container">
      <div class="section-head connect__head">
        <h2 id="connect-h">Working across time zones</h2>
        <p>I’ve collaborated remotely with teams across several regions. Clear communication and thoughtful handoffs help keep the work moving.</p>
      </div>
      <div class="map" style="--ar: 1000 / 433">
        {%- include "svg/world-map.svg" -%}
        {%- for pin in mapPins %}
        <div class="map__pin" data-at="{{ pin.at }}" style="left: {{ pin.left }}; top: {{ pin.top }}">
          {%- if pin.clients | length %}
          <button class="map__hit" type="button" aria-expanded="false" aria-controls="map-fan-{{ loop.index }}"><i class="map__dot"></i><b class="map__pill">{{ pin.name }}</b></button>
          <ul class="map__fan" id="map-fan-{{ loop.index }}" aria-label="Clients in {{ pin.name }}" style="--n: {{ pin.clients | length }}">
            {%- for client in pin.clients %}
            <li class="map__logo" style="--i: {{ loop.index0 }}">
              {%- if client.logo -%}
              <img src="{{ client.logo | rel }}" alt="{{ client.name }}" width="80" height="80" loading="lazy" decoding="async" />
              {%- else -%}
              <span aria-hidden="true">{% for word in client.name.split(" ") %}{% if loop.index <= 2 %}{{ word | first | upper }}{% endif %}{% endfor %}</span><span class="sr-only">{{ client.name }}</span>
              {%- endif -%}
            </li>
            {%- endfor %}
          </ul>
          {%- else %}
          <span class="map__hit" aria-hidden="true"><i class="map__dot"></i><b class="map__pill">{{ pin.name }}</b></span>
          {%- endif %}
        </div>
        {%- endfor %}
      </div>
      <p class="sr-only">
        I have worked with teams in: United Kingdom, Netherlands, South Africa, India, Bangladesh,
        United States, Hawaii.
      </p>
      <div class="cpanel" id="contact">
        {#- Text on the left; the watercolor window sits in the third column, above the divider (wide screens only),
            with an "Artistic Creations: Coming Soon" note beside it and a hand-drawn arrow rising from the window to it. #}
        <div class="cpanel__intro">
          <div class="cpanel__text">
            <h3 class="cpanel__title">Let’s design a better product experience.</h3>
            <p class="cpanel__sub">
              I’m open to on-site/remote product design roles and thoughtful collaborations. If you’re working on a
              product that needs clearer flows, stronger interfaces, or a more considered design approach,
              I’d like to hear about it.
            </p>
          </div>
          <div class="cpanel__aside">
            <img class="cpanel__art" src="{{ '/assets/images/contact-window.webp' | rel }}" alt="" width="240" height="240" loading="lazy" decoding="async" />
            <p class="cpanel__soon">
              <span class="cpanel__soon-kicker">Artistic Creations:</span>
              <span class="cpanel__soon-label">Coming Soon</span>
              <img class="cpanel__arrow" src="{{ '/assets/images/arrow-loop.svg' | rel }}" alt="" width="383" height="354" loading="lazy" decoding="async" />
            </p>
          </div>
        </div>
        <div class="cpanel__cols">
          <div>
            <p class="cpanel__label">Email:</p>
            <a class="cpanel__mail" href="mailto:{{ site.email }}"><span class="btn__icon">{{ icon("mail") }}</span>{{ site.email }}</a>
          </div>
          <div>
            <p class="cpanel__label">Resume:</p>
            <a class="cpanel__mail cpanel__dl" href="{{ site.resume | rel }}" target="_blank" rel="noopener">
              {#- #}<span>Download Resume</span><span class="btn__icon">{{ icon("arrow-up-right") }}</span><span class="sr-only"> (opens in a new tab)</span>
            {#- #}</a>
          </div>
          <div>
            <p class="cpanel__label">I know you want to follow, so:</p>
            <ul class="cpanel__social">
              {%- for link in site.social %}
              <li>{{ socialLink(link.name, link.url) }}</li>
              {%- endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
  {% include "partials/footer.njk" %}
</div>
<script defer src="{{ '/assets/js/map-clients.js' | rel }}"></script>
