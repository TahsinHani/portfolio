{# A round social link: socialLink("LinkedIn", "https://www.linkedin.com/") #}
{%- macro socialLink(name, url) -%}
<a class="social-link" href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ name }} (opens in a new tab)">{{ socialIcon(name) }}</a>
{%- endmacro %}
