---
layout: layouts/base.njk
---
{#-
  Case study page. Every case study uses the same "story" template (styles in story.css, behaviour in
  story.js). Everything above and below the story comes from the page's front matter; the page body
  (the numbered story sections) is inserted at {{ content }}.
  See src/case-studies/ for the pages, akij-insaf.njk for every building block, and the field list
  in case-studies.11tydata.js.
-#}
{% from "components/button.njk" import button %}
{% from "components/project-card.njk" import projectGrid with context %}
<main id="work">
  <article class="cs cs--story">
    <header class="cs__top container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="{{ '/index.html' | rel }}">Home</a></li>
          <li><a href="{{ '/work/index.html' | rel }}">Work</a></li>
          <li aria-current="page">{{ title }}</li>
        </ol>
      </nav>
      {%- if headline %}
      <p class="cs__eyebrow">{{ title }}</p>
      {%- endif %}
      {#- headlineHand: one word of the headline set in the handwriting font (first match only) #}
      {%- set heading = (headline or title) | escape | string %}
      {%- if headlineHand %}
      {%- set heading = heading | replace(headlineHand, '<span class="cs__hand">' + headlineHand + '</span>', 1) %}
      {%- endif %}
      <h1 class="cs__title">{{ heading | safe }}</h1>
      <p class="cs__summary">{{ lead or summary }}</p>
      {%- if website %}
      <div class="cs__actions">
        {{ button(websiteLabel or "View Website", website, trail="arrow-up-right", external=true) }}
      </div>
      {%- endif %}
      <dl class="cs__meta">
        {%- for fact in facts %}
        <div>
          <dt>{{ fact.label }}</dt>
          <dd>{{ fact.value }}</dd>
        </div>
        {%- endfor %}
      </dl>
      {%- if demo %}
      <p class="cs__demo">Demo case study. Text and images are placeholders.</p>
      {%- endif %}
    </header>

    <figure class="cs__cover container">
      <img src="{{ ('/assets/images/projects/' + (cover.image or page.fileSlug) + '.webp') | rel }}" width="1200" height="900" alt="{{ cover.alt }}" fetchpriority="high" />
      {%- if cover.caption %}
      <figcaption>{{ cover.caption }}</figcaption>
      {%- endif %}
    </figure>

    {%- if glance %}
    <section class="cs__trio container" aria-label="At a glance">
      {%- for item in glance %}
      <div class="pcard">
        <h2 class="pcard__word">{{ item.word }}</h2>
        <p class="pcard__text">{{ item.text }}</p>
      </div>
      {%- endfor %}
    </section>
    {%- endif %}

    <div class="cs__body container">
      {{ content | safe }}
      {%- if credits %}
      <section class="cs__sec st-credits" aria-labelledby="credits-h">
        <h2 class="st-k rv" id="credits-h">Project credits</h2>
        <dl class="st-details st-wide rv">
          {%- for item in credits %}
          <div>
            <dt>{{ item.label }}</dt>
            <dd>{{ item.value }}</dd>
          </div>
          {%- endfor %}
        </dl>
      </section>
      {%- endif %}
    </div>

    <section class="cs__more container" aria-labelledby="more-h">
      <div class="section-head"><h2 id="more-h">More work</h2></div>
      {{ projectGrid(collections.caseStudies | bySlug(moreWork), class="allwork__grid cs__moregrid") }}
      <div class="work__more">
        {{ button("See my all work", "/work/index.html" | rel, variant="secondary", trail="arrow-right") }}
      </div>
    </section>

    <section class="section connect" id="connect" aria-labelledby="contact-h">
      <div class="container">
        {% set contactHeading = "h2" %}
        {% include "partials/contact-card.njk" %}
      </div>
    </section>
  </article>
  <script defer src="{{ '/assets/js/story.js' | rel }}"></script>
</main>
