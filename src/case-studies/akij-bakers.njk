          loading="lazy"
          decoding="async"
        />
        <figcaption>Revised: real food photography in a framed, offset grid</figcaption>
      </figure>
    </div>
    <div class="st-gal" role="tabpanel" id="p-r1" aria-labelledby="t-r1">
      <figure class="cs__fig">
